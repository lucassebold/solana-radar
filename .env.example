# Keys (never commit the real .env)
HELIUS_API_KEY=
MADEONSOL_API_KEY=

# Secret that Helius sends in the Authorization header of every webhook call (use a long random value)
WEBHOOK_SECRET=

# Public URL of the server (e.g. https://your-app.up.railway.app). Empty = no webhook registered (local mode).
PUBLIC_URL=

# Optional
PORT=3000
RANKING_SIZE=50
RANKING_REFRESH_HOURS=6
WINDOW_MINUTES=5
MIN_WALLETS=3
MIN_BUY_SOL=0.01
DAILY_EVENT_WARN=30000

# History (SQLite). On Railway attach a Volume mounted at /data (RAILWAY_VOLUME_MOUNT_PATH is picked up automatically).
# DATA_DIR=/data
RETENTION_DAYS=90
PAIRS_DAYS=30
PAIRS_MIN_COUNT=2

# Helius credit budget (see README). Set BILLING_DAY to the day your Helius cycle resets (UTC) and
# CREDITS_USED_OFFSET to the credits already used this cycle before this app started counting (Helius dashboard > Usage).
BILLING_DAY=1
CREDITS_USED_OFFSET=0
# RANKING_SOURCE=alpha
# POOL_SIZE=300
# BUDGET_FRACTION=0.9
# HARD_STOP_FRACTION=0.97

# Pause the radar: deletes the Helius webhook at start and keeps it deleted (no credits spent). Remove to resume.
# RADAR_PAUSED=true
