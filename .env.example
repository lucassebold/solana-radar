# Chaves (nunca commitar o .env real)
HELIUS_API_KEY=
MADEONSOL_API_KEY=

# Segredo que a Helius envia no cabecalho Authorization de cada webhook (gere um valor aleatorio longo)
WEBHOOK_SECRET=

# URL publica do servidor (ex.: https://seu-app.up.railway.app). Vazio = nao registra webhook (modo local).
PUBLIC_URL=

# Opcionais
PORT=3000
RANKING_SIZE=50
RANKING_REFRESH_HOURS=6
WINDOW_MINUTES=5
MIN_WALLETS=3
MIN_BUY_SOL=0.01
